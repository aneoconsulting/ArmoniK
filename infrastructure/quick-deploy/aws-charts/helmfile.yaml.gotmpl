# Everything that runs in the cluster, on top of the infrastructure Terraform creates. The
# environment values are the Terraform outputs (make output), so run it through the Makefile or
# after make output. docs/helm-cli.md gives the same deployment with plain helm commands.
environments:
  default:
    values:
      - generated/armonik-output.json
      - charts:
          # ARMONIK_CHARTS_DIR points to a local ArmoniK.Infra/charts checkout (dependencies vendored
          # with its update-charts.sh), instead of the published charts
          armonikDir: {{ env "ARMONIK_CHARTS_DIR" | default "" | quote }}
          armonik: {{ env "ARMONIK_CHART_VERSION" | default "0.16.0-featpostgresmig.296.sha.67d6b6e4" | quote }}
          karpenter: "1.14.1"
          awsLoadBalancerController: "3.5.0"
---
helmDefaults:
  wait: true
  # No waitForJobs: the ArmoniK init Jobs set ttlSecondsAfterFinished: 1, so they are deleted before
  # helm checks them and the release fails with "jobs.batch ... not found"
  timeout: 900
  createNamespace: true

repositories:
  # Published on public.ecr.aws, pulled through the cache
  - name: karpenter
    url: {{ .Values.registry.upstreams.ecrPublic }}/karpenter
    oci: true
  # Published on Docker Hub, pulled through the cache
  - name: armonik-charts
    url: {{ .Values.registry.upstreams.dockerHub }}/dockerhubaneo
    oci: true
  # Classic HTTP repository: the one chart ECR cannot cache
  - name: eks
    url: https://aws.github.io/eks-charts

{{- $armonikCharts := .Values.charts.armonikDir | default "armonik-charts" }}

releases:
  - name: karpenter
    namespace: kube-system
    chart: karpenter/karpenter
    version: {{ .Values.charts.karpenter | quote }}
    values:
      - values/karpenter.yaml.gotmpl

  - name: karpenter-nodes
    namespace: kube-system
    chart: ./charts/karpenter-nodes
    needs:
      - kube-system/karpenter
    values:
      - values/karpenter-nodes.yaml.gotmpl

  - name: aws-load-balancer-controller
    namespace: kube-system
    chart: eks/aws-load-balancer-controller
    version: {{ .Values.charts.awsLoadBalancerController | quote }}
    needs:
      - kube-system/karpenter-nodes
    values:
      - values/aws-load-balancer-controller.yaml.gotmpl

  - name: armonik-operators
    namespace: {{ .Values.namespaces.operators }}
    chart: {{ $armonikCharts }}/armonik-operators
    {{- if not .Values.charts.armonikDir }}
    version: {{ .Values.charts.armonik | quote }}
    {{- end }}
    needs:
      - kube-system/aws-load-balancer-controller
    values:
      - values/armonik-operators.yaml.gotmpl

  - name: aws-secret-store
    namespace: {{ .Values.namespaces.operators }}
    chart: ./charts/aws-secret-store
    needs:
      - {{ .Values.namespaces.operators }}/armonik-operators
    values:
      - values/aws-secret-store.yaml.gotmpl

  - name: armonik
    namespace: {{ .Values.namespaces.armonik }}
    chart: {{ $armonikCharts }}/armonik
    {{- if not .Values.charts.armonikDir }}
    version: {{ .Values.charts.armonik | quote }}
    {{- end }}
    needs:
      - {{ .Values.namespaces.operators }}/aws-secret-store
    values:
      - values/armonik.yaml.gotmpl
      # Optional overrides of the deployment (partitions, resources...), git-ignored
      {{- if isFile "values/local.yaml" }}
      - values/local.yaml
      {{- end }}
