{{- $r := mergeOverwrite (deepCopy .Values.registry.upstreams) .Values.registries }}
# Release karpenter, chart karpenter/karpenter (public.ecr.aws), namespace kube-system.
# Karpenter adds and removes EC2 nodes after the pending pods. It is the only thing that must not run on
# a node it manages itself, hence the system node group below.
settings:
  # Names what Terraform created: the cluster, and the SQS queue fed by EventBridge with the spot
  # interruptions and rebalance recommendations
  clusterName: "{{ .Values.eks.name }}"
  interruptionQueue: "{{ .Values.karpenter.queue_name }}"

controller:
  image:
    # Without this the chart pulls public.ecr.aws/karpenter/controller
    repository: "{{ $r.ecrPublic }}/karpenter/controller"
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: 250m
      memory: 512Mi

{{- if .Values.registryAuth }}
# Registry with authentication (registryAuth in settings.yaml): the Secret must exist in kube-system
imagePullSecrets:
  - name: registry-credentials
{{- end }}

# On the small managed node group Terraform creates (tainted CriticalAddonsOnly, which the chart tolerates)
nodeSelector:
  kubernetes.io/os: linux
  armonik.aneo.fr/node-group: system

# AWS credentials come from EKS Pod Identity (association kube-system/karpenter, created by Terraform):
# the chart needs no annotation and no secret.
