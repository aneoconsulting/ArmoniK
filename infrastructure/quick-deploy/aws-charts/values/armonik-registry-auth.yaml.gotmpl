# Layer over armonik.yaml.gotmpl when registryAuth is set (settings.yaml): a registry that needs authentication.
# The ECR pull-through cache needs none of it: nodes authenticate to ECR with their IAM role.
#
# The Secret (type kubernetes.io/dockerconfigjson) must exist in the armonik namespace first (README, step 1).
# Each chart family reads its own key. A node-level alternative needs none of this: give containerd the
# credentials in the EC2NodeClass userData.
global:
  imagePullSecrets:
    - name: registry-credentials   # ArmoniK pods
dependencies:
  fluent-bit:
    imagePullSecrets:
      - name: registry-credentials
  seq:
    imagePullSecrets:
      - name: registry-credentials
