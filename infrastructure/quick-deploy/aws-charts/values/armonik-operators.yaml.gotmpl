{{- $r := .Values.registry.upstreams }}
# Install-once operators. PostgreSQL is RDS and MongoDB is not used: neither operator is installed.
global:
  armonik:
    operators:
      mongodbOperator:
        deploy: false
        available: false
      postgresqlOperator:
        deploy: false
        available: false
      googleCasIssuer:
        deploy: false
        available: false

external-secrets:
  # Bound by Pod Identity to the role reading the RDS master user secret
  serviceAccount:
    name: external-secrets
  image:
    repository: {{ printf "%s/external-secrets/external-secrets" $r.ghcr | quote }}
  webhook:
    image:
      repository: {{ printf "%s/external-secrets/external-secrets" $r.ghcr | quote }}
  certController:
    image:
      repository: {{ printf "%s/external-secrets/external-secrets" $r.ghcr | quote }}

keda:
  image:
    keda:
      registry: {{ $r.ghcr | quote }}
    metricsApiServer:
      registry: {{ $r.ghcr | quote }}
    webhooks:
      registry: {{ $r.ghcr | quote }}

cert-manager:
  imageRegistry: {{ $r.quay | quote }}

kube-prometheus:
  windowsMonitoring:
    enabled: false
  crds:
    upgradeJob:
      image:
        busybox:
          registry: {{ $r.dockerHub | quote }}
          repository: library/busybox
        kubectl:
          registry: {{ $r.k8s | quote }}
  prometheusOperator:
    image:
      registry: {{ $r.quay | quote }}
    prometheusConfigReloader:
      image:
        registry: {{ $r.quay | quote }}
    # Unused (no Thanos sidecar), overridden so no image reference points outside the cache
    thanosImage:
      registry: {{ $r.quay | quote }}
    admissionWebhooks:
      patch:
        image:
          registry: {{ $r.ghcr | quote }}
  prometheus:
    prometheusSpec:
      image:
        registry: {{ $r.quay | quote }}
  prometheus-node-exporter:
    # The operators chart turns it off for Docker Desktop, which does not apply here
    hostRootFsMount:
      enabled: true
    # On every node, the tainted worker nodes included
    tolerations:
      - operator: Exists
    image:
      registry: {{ $r.quay | quote }}
    kubeRBACProxy:
      image:
        registry: {{ $r.quay | quote }}
    permissionInitContainer:
      image:
        registry: {{ $r.quay | quote }}
  kube-state-metrics:
    image:
      registry: {{ $r.k8s | quote }}
    kubeRBACProxy:
      image:
        registry: {{ $r.quay | quote }}
