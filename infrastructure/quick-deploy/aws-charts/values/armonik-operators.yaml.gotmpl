{{- $r := mergeOverwrite (deepCopy .Values.registry.upstreams) .Values.registries }}
# Release armonik-operators, chart armonik-charts/armonik-operators (Docker Hub), namespace of the operators.
# The operators ArmoniK needs, installed once per cluster: External Secrets (ESO), KEDA, cert-manager and
# kube-prometheus-stack. The armonik release then only emits their custom resources.
#
# Every image below is repointed to $r: the ECR pull-through cache by default, Artifactory when
# settings.yaml says so. Each upstream keeps its own prefix because a registry such as Docker Hub
# and GHCR do not share a namespace.
global:
  armonik:
    operators:
      # PostgreSQL is external and MongoDB is not used: neither operator is installed.
      mongodbOperator:
        deploy: false
        available: false
      postgresqlOperator:
        deploy: false
        available: false
      # GCP only
      googleCasIssuer:
        deploy: false
        available: false

# Registry that needs a pull secret (registryAuth in settings.yaml): the Secret (type
# kubernetes.io/dockerconfigjson) must exist in the operators namespace first (README, step 1). Each subchart
# reads its own key, hence the imagePullSecrets in each block below.

external-secrets:
  {{- if .Values.registryAuth }}
  global:                 # reaches the controller, the webhook and the cert controller
    imagePullSecrets: [{name: registry-credentials}]
  {{- end }}
  # Name bound by Pod Identity to the role that reads the RDS secret (Terraform)
  serviceAccount:
    name: external-secrets
  image:
    repository: "{{ $r.ghcr }}/external-secrets/external-secrets"
  webhook:
    image:
      repository: "{{ $r.ghcr }}/external-secrets/external-secrets"
  certController:
    image:
      repository: "{{ $r.ghcr }}/external-secrets/external-secrets"

keda:
  {{- if .Values.registryAuth }}
  imagePullSecrets: [{name: registry-credentials}]
  {{- end }}
  image:
    keda:
      registry: "{{ $r.ghcr }}"
    metricsApiServer:
      registry: "{{ $r.ghcr }}"
    webhooks:
      registry: "{{ $r.ghcr }}"

cert-manager:
  {{- if .Values.registryAuth }}
  global:
    imagePullSecrets: [{name: registry-credentials}]
  {{- end }}
  imageRegistry: "{{ $r.quay }}"

# kube-prometheus-stack, as the chart names it in armonik-operators
kube-prometheus:
  {{- if .Values.registryAuth }}
  global:
    imagePullSecrets: [{name: registry-credentials}]
  {{- end }}
  windowsMonitoring:
    enabled: false
  crds:
    upgradeJob:
      image:
        busybox:
          registry: "{{ $r.dockerHub }}"
          repository: library/busybox
        kubectl:
          registry: "{{ $r.k8s }}"
  prometheusOperator:
    image:
      registry: "{{ $r.quay }}"
    prometheusConfigReloader:
      image:
        registry: "{{ $r.quay }}"
    # Unused (no Thanos sidecar), overridden so no image reference points outside the registry you chose
    thanosImage:
      registry: "{{ $r.quay }}"
    admissionWebhooks:
      patch:
        image:
          registry: "{{ $r.ghcr }}"
  prometheus:
    prometheusSpec:
      image:
        registry: "{{ $r.quay }}"
      # Retention and storage: none by default (emptyDir). For a customer environment, keep the metrics:
      # retention: 15d
      # storageSpec:
      #   volumeClaimTemplate:
      #     spec:
      #       storageClassName: gp3
      #       resources:
      #         requests:
      #           storage: 50Gi
  prometheus-node-exporter:
    # The chart turns it off for Docker Desktop, which does not apply here
    hostRootFsMount:
      enabled: true
    # On every node, the tainted worker nodes included
    tolerations:
      - operator: Exists
    image:
      registry: "{{ $r.quay }}"
    kubeRBACProxy:
      image:
        registry: "{{ $r.quay }}"
    permissionInitContainer:
      image:
        registry: "{{ $r.quay }}"
  kube-state-metrics:
    image:
      registry: "{{ $r.k8s }}"
    kubeRBACProxy:
      image:
        registry: "{{ $r.quay }}"
