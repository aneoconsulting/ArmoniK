{{- $r := mergeOverwrite (deepCopy .Values.registry.upstreams) .Values.registries }}
# Release aws-load-balancer-controller, chart eks/aws-load-balancer-controller (https://aws.github.io/eks-charts),
# namespace kube-system. Turns the ingress Service of type LoadBalancer into an NLB.
clusterName: "{{ .Values.eks.name }}"
# Stated since the nodes' IMDS is out of the pods' reach (hop limit 1, see the EC2NodeClass)
region: "{{ .Values.eks.region }}"
vpcId: "{{ .Values.eks.vpc_id }}"

# Reuse the webhook TLS secret on upgrade: the chart otherwise generates a new CA on every render, and
# the armonik release that follows may hit the webhook while the controller still serves the old one
keepTLSSecret: true

serviceAccount:
  create: true
  # Name bound to the IAM role by Pod Identity (Terraform)
  name: aws-load-balancer-controller

image:
  repository: "{{ $r.ecrPublic }}/eks/aws-load-balancer-controller"

{{- if .Values.registryAuth }}
# Registry with authentication (registryAuth in settings.yaml): the Secret must exist in kube-system
imagePullSecrets:
  - name: registry-credentials
{{- end }}
