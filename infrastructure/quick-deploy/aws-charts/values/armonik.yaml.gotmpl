{{- $r := .Values.registry.upstreams }}
{{- $ops := .Values.namespaces.operators }}
{{- $pg := .Values.postgresql }}
global:
  armonik:
    # Installed by the armonik-operators release
    operators:
      externalSecrets:
        deploy: false
        available: true
        namespace: {{ $ops | quote }}
      keda:
        deploy: false
        available: true
        namespace: {{ $ops | quote }}
      certManager:
        deploy: false
        available: true
        namespace: {{ $ops | quote }}
      prometheusOperator:
        deploy: false
        available: true
        namespace: {{ $ops | quote }}
      mongodbOperator:
        deploy: false
        available: false
      postgresqlOperator:
        deploy: false
        available: false
      googleCasIssuer:
        deploy: false
        available: false
    monitoring:
      # kube-prometheus-stack of the operators release (fullnameOverride "prometheus")
      prometheusUrl: {{ printf "http://prometheus-prometheus.%s.svc:9090" $ops | quote }}
    # Core from ArmoniK.Core#1302, which renames the PostgreSQL component identifiers below
    # (PostgresSQL up to 0.41.0): the version and the identifiers move together
    versions:
      core: "0.42.0-refactorrenamepostgresqladapto.26.sha.4f4d363d"
      gui: "0.16.0"

# Storage: RDS PostgreSQL, S3 and SQS, all outside the cluster
conf:
  core:
    env:
      AWS_REGION: {{ .Values.eks.region | quote }}
      Components__TableStorage: ArmoniK.Adapters.PostgreSQL.TableStorage
      Components__AuthenticationStorage: ArmoniK.Adapters.PostgreSQL.AuthenticationTable
      PostgreSQL__Host: {{ $pg.host | quote }}
      PostgreSQL__Port: {{ $pg.port | quote }}
      PostgreSQL__DatabaseName: {{ $pg.database | quote }}
      PostgreSQL__Ssl: "true"
      # S3 object storage, disabled while benchmarking Valkey (dependencies.redis below): conf.core is
      # merged last, so these would override the Redis object-storage env of the chart
      # Components__ObjectStorageAdaptorSettings__ClassName: ArmoniK.Core.Adapters.S3.ObjectBuilder
      # Components__ObjectStorageAdaptorSettings__AdapterAbsolutePath: /adapters/object/s3/ArmoniK.Core.Adapters.S3.dll
      # S3__EndpointUrl: {{ .Values.object_storage.endpoint | quote }}
      # S3__BucketName: {{ .Values.object_storage.bucket | quote }}
      # S3__MustForcePathStyle: "false"
      Components__QueueAdaptorSettings__ClassName: ArmoniK.Core.Adapters.SQS.QueueBuilder
      Components__QueueAdaptorSettings__AdapterAbsolutePath: /adapters/queue/sqs/ArmoniK.Core.Adapters.SQS.dll
      SQS__ServiceURL: {{ .Values.queue.endpoint | quote }}
      SQS__Prefix: {{ .Values.queue.prefix | quote }}
    # RDS master user, from the Secrets Manager secret RDS manages
    envFromSecret:
      PostgreSQL__User:
        storeName: aws-secrets-manager
        storeKind: ClusterSecretStore
        secret: {{ $pg.secret_arn | quote }}
        field: username
      PostgreSQL__Password:
        storeName: aws-secrets-manager
        storeKind: ClusterSecretStore
        secret: {{ $pg.secret_arn | quote }}
        field: password

control-plane:
  serviceAccount:
    create: true
    name: {{ .Values.service_accounts.control_plane | quote }}
  image:
    registry: {{ $r.dockerHub | quote }}
  metricsExporter:
    image:
      registry: {{ $r.dockerHub | quote }}
  init:
    image:
      registry: {{ $r.dockerHub | quote }}

compute-plane:
  # Bench isn't in the default chart so here it is
  partitions:
    bench:
      worker:
        image:
          repository: "dockerhubaneo/armonik_core_bench_test_worker"
  serviceAccount:
    create: true
    name: {{ .Values.service_accounts.compute_plane | quote }}
  init:
    image:
      registry: {{ $r.dockerHub | quote }}
  fluentBit:
    image:
      registry: {{ $r.dockerHub | quote }}
  partitionCommon:
    # Workers node pool; do-not-disrupt keeps Karpenter from evicting a running task
    nodeSelector:
      armonik.aneo.fr/node-pool: workers
    tolerations:
      - key: armonik.aneo.fr/node-pool
        operator: Equal
        value: workers
        effect: NoSchedule
    podAnnotations:
      karpenter.sh/do-not-disrupt: "true"
    # The chart caps KEDA at 5 pods per partition; Karpenter adds the nodes, up to the workers pool limit
    hpa:
      maxReplicaCount: 50
    # requests == limits: Guaranteed QoS, predictable task runtimes and exact Karpenter sizing
    agent:
      image:
        registry: {{ $r.dockerHub | quote }}
      resources:
        requests:
          cpu: 500m
          memory: 512Mi
        limits:
          cpu: 500m
          memory: 512Mi
    worker:
      image:
        registry: {{ $r.dockerHub | quote }}
      resources:
        requests:
          cpu: "1"
          memory: 1Gi
        limits:
          cpu: "1"
          memory: 1Gi

ingress:
  image:
    registry: {{ $r.dockerHub | quote }}
  loadBalancer:
    image:
      registry: {{ $r.dockerHub | quote }}
  gui:
    image:
      registry: {{ $r.dockerHub | quote }}
  # Internet-facing NLB, provisioned by the AWS Load Balancer Controller
  service:
    type: LoadBalancer
    annotations:
      service.beta.kubernetes.io/aws-load-balancer-type: external
      service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: ip
      service.beta.kubernetes.io/aws-load-balancer-scheme: internet-facing

dependencies:
  mongodb:
    enabled: false
  mongodb-exporter:
    enabled: false
  postgresql:
    enabled: false
  # Valkey as object storage (the chart wires Core to it); back to S3: enabled false + uncomment the S3 env above
  redis:
    enabled: true
    image:
      registry: {{ $r.ecrPublic | quote }}
    metrics:
      exporter:
        image:
          registry: {{ $r.ghcr | quote }}
    # Dedicated storage pool: on-demand memory-optimized node, never consolidated while Valkey runs
    nodeSelector:
      armonik.aneo.fr/node-pool: storage
    tolerations:
      - key: armonik.aneo.fr/node-pool
        operator: Equal
        value: storage
        effect: NoSchedule
    # requests == limits: Guaranteed QoS, and sizes the node (r-class, 16 GB)
    resources:
      requests:
        cpu: "2"
        memory: 8Gi
      limits:
        cpu: "2"
        memory: 8Gi
    valkeyConfig: |
      save ""
      appendonly no
      maxmemory 6gb
  activemq:
    enabled: false
  rabbitmq:
    enabled: false
  grafana:
    image:
      registry: {{ $r.dockerHub | quote }}
    downloadDashboardsImage:
      registry: {{ $r.dockerHub | quote }}
    initChownData:
      image:
        registry: {{ $r.dockerHub | quote }}
    sidecar:
      image:
        registry: {{ $r.quay | quote }}
  fluent-bit:
    # cr.fluentbit.io cannot be cached by ECR: same image, from Docker Hub
    image:
      repository: {{ printf "%s/fluent/fluent-bit" $r.dockerHub | quote }}
    hotReload:
      image:
        repository: {{ printf "%s/jimmidyson/configmap-reload" $r.ghcr | quote }}
    # On every node, the tainted worker nodes included
    tolerations:
      - operator: Exists
  seq:
    image:
      repository: {{ printf "%s/datalust/seq" $r.dockerHub | quote }}
    gelf:
      image:
        repository: {{ printf "%s/datalust/seq-input-gelf" $r.dockerHub | quote }}
    syslog:
      image:
        repository: {{ printf "%s/datalust/seq-input-syslog" $r.dockerHub | quote }}
