{{- $r := mergeOverwrite (deepCopy .Values.registry.upstreams) .Values.registries }}
# Release armonik, chart armonik-charts/armonik (Docker Hub, dockerhubaneo), namespace of armonik.
#
# Customer scenario:
#   - table storage   RDS PostgreSQL (external), credentials read from Secrets Manager through ESO
#   - object storage  S3, reached with the Pod Identity of the ArmoniK service accounts
#   - queue           SQS
#   - monitoring      the operators' Prometheus, the customer's own Grafana (not deployed here)
#   - registries      ECR pull-through cache, or Artifactory (registries in settings.yaml)
# Two optional layers go on top, switched in settings.yaml: armonik-hardening.yaml.gotmpl (hardening:
# NetworkPolicies) and armonik-registry-auth.yaml.gotmpl (registryAuth: pull secrets, for Artifactory).
global:
  armonik:
    # The operators are installed by the armonik-operators release: this release only uses them
    operators:
      externalSecrets:
        deploy: false
        available: true
        namespace: "{{ .Values.namespaces.operators }}"
      keda:
        deploy: false
        available: true
        namespace: "{{ .Values.namespaces.operators }}"
      certManager:
        deploy: false
        available: true
        namespace: "{{ .Values.namespaces.operators }}"
      prometheusOperator:
        deploy: false
        available: true
        namespace: "{{ .Values.namespaces.operators }}"
      mongodbOperator:
        deploy: false
        available: false
      postgresqlOperator:
        deploy: false
        available: false
      googleCasIssuer:
        deploy: false
        available: false
    monitoring:
      # Prometheus of the kube-prometheus-stack in armonik-operators (fullnameOverride "prometheus").
      # KEDA queries it, and so does the Grafana datasource below. Point it elsewhere to reuse the
      # customer's Prometheus (it must then scrape the ArmoniK ServiceMonitors).
      prometheusUrl: "http://prometheus-prometheus.{{ .Values.namespaces.operators }}.svc:9090"
    # Image tags. Pin them: an empty value follows the chart's appVersion.
    versions:
      # The PostgreSQL adapters come with this Core build (ArmoniK.Core#1302)
      core: "0.42.0-refactorrenamepostgresqladapto.26.sha.4f4d363d"
      gui: "0.16.0"

control-plane:
  serviceAccount:
    create: true
    # Bound to the S3/SQS role by Pod Identity (Terraform): the name is a contract
    name: "{{ .Values.service_accounts.control_plane }}"
  image:
    registry: "{{ $r.dockerHub }}"
  metricsExporter:
    image:
      registry: "{{ $r.dockerHub }}"
  init:
    image:
      registry: "{{ $r.dockerHub }}"

compute-plane:
  serviceAccount:
    create: true
    name: "{{ .Values.service_accounts.compute_plane }}"
  init:
    image:
      registry: "{{ $r.dockerHub }}"
  fluentBit:
    image:
      registry: "{{ $r.dockerHub }}"
  # Partitions accumulate with the chart's own (default, stream, htcmock). Your worker goes here:
  # partitions:
  #   my-app:
  #     worker:
  #       image:
  #         registry: {{ $r.dockerHub }}        # or your own Artifactory repository
  #         repository: my-team/my-worker
  #         tag: 1.2.3
  #       resources:
  #         requests: {cpu: "2", memory: 4Gi}
  #         limits: {cpu: "2", memory: 4Gi}
  partitionCommon:
    # Workers node pool (Karpenter, spot first, tainted); do-not-disrupt keeps Karpenter from evicting a task
    nodeSelector:
      armonik.aneo.fr/node-pool: workers
    tolerations:
      - key: armonik.aneo.fr/node-pool
        operator: Equal
        value: workers
        effect: NoSchedule
    podAnnotations:
      karpenter.sh/do-not-disrupt: "true"
    # KEDA scales a partition on its queue length, from 0 to this many pods
    hpa:
      maxReplicaCount: 50
    # The agent keeps the chart's resources (requests 500m/256Mi, limits 1/1Gi)
    agent:
      image:
        registry: "{{ $r.dockerHub }}"
    # The worker runs the tasks: requests == limits, for predictable task runtimes and exact Karpenter sizing
    worker:
      image:
        registry: "{{ $r.dockerHub }}"
      resources:
        requests: {cpu: "1", memory: 1Gi}
        limits: {cpu: "1", memory: 1Gi}

ingress:
  # Envoy Gateway is the only entry point (charts/armonik-gateway). The chart always renders its nginx,
  # which has no enabled flag: no pod, and a ClusterIP Service, so no NLB. Its Gateway API objects stay
  # off: the chart only renders an HTTPRoute, and the control plane needs a GRPCRoute (HTTP/2 upstream).
  replicas: 0
  service:
    type: ClusterIP
  gateway:
    enabled: false
  httpRoute:
    enabled: false
  image:
    registry: "{{ $r.dockerHub }}"
  loadBalancer:
    image:
      registry: "{{ $r.dockerHub }}"
  gui:
    image:
      registry: "{{ $r.dockerHub }}"
  # The customer's Grafana, linked from the admin GUI. The chart requires one of the *_url values. The
  # /grafana/ proxy was nginx's: with Envoy, users reach their Grafana directly.
  grafana_url: "{{ .Values.grafanaUrl }}"

dependencies:
  # ---- Table storage: RDS PostgreSQL --------------------------------------------------------------------
  # One backend per slot: the chart refuses to render with mongodb and externalPostgresql both enabled.
  mongodb:
    enabled: false
  mongodb-exporter:
    enabled: false
  externalPostgresql:
    enabled: true
    host: "{{ .Values.postgresql.host }}"
    port: {{ .Values.postgresql.port }}
    database: "{{ .Values.postgresql.database }}"
    # RDS has rds.force_ssl=1 (terraform/rds.tf): Core connects over TLS
    ssl: true
    credentials:
      # The Secrets Manager secret RDS manages for the master user, as {"username", "password"}.
      # storeName/storeKind make the chart emit an ExternalSecret on the ClusterSecretStore of the
      # aws-secret-store release, whose pods read it at startup.
      secret: "{{ .Values.postgresql.secret_arn }}"
      storeName: aws-secrets-manager
      storeKind: ClusterSecretStore
      # Without storeName the secret is a Kubernetes Secret of the namespace with these keys instead:
      #   secret: my-postgres-credentials
      #   usernameField: username
      #   passwordField: password

  # ---- Queue: SQS ---------------------------------------------------------------------------------------
  # Core creates the queues itself, named after the prefix: the IAM policy of Terraform covers prefix*
  sqs:
    enabled: true
    region: "{{ .Values.eks.region }}"
    prefix: "{{ .Values.queue.prefix }}"
  activemq:
    enabled: false
  rabbitmq:
    enabled: false

  # ---- Object storage: S3 --------------------------------------------------------------------------------
  # Bucket created by Terraform (SSE-KMS). No credentials: the control and compute planes reach it with
  # their Pod Identity role, which grants this bucket and its KMS key.
  s3:
    enabled: true
    region: "{{ .Values.eks.region }}"
    bucketName: "{{ .Values.object_storage.bucket }}"
  # Valkey (the chart's default object storage) is not deployed
  redis:
    enabled: false

  # ---- Monitoring -----------------------------------------------------------------------------------------
  # The customer runs its own Grafana: not deployed here. This also drops the datasource and the dashboards
  # ConfigMaps the chart renders for its Grafana: see docs/grafana-dashboards.md to load them
  # in yours.
  grafana:
    enabled: false
  fluent-bit:
    # cr.fluentbit.io is not an ECR upstream: the same image from Docker Hub
    image:
      repository: "{{ $r.dockerHub }}/fluent/fluent-bit"
    hotReload:
      image:
        repository: "{{ $r.ghcr }}/jimmidyson/configmap-reload"
    # On every node, the tainted worker nodes included
    tolerations:
      - operator: Exists
  seq:
    image:
      repository: "{{ $r.dockerHub }}/datalust/seq"
    gelf:
      image:
        repository: "{{ $r.dockerHub }}/datalust/seq-input-gelf"
    syslog:
      image:
        repository: "{{ $r.dockerHub }}/datalust/seq-input-syslog"
    # Seq (logs) starts without authentication in the chart's defaults: see armonik-hardening.yaml
