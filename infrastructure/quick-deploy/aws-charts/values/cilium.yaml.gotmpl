{{- $r := mergeOverwrite (deepCopy .Values.registry.upstreams) .Values.registries }}
# Release cilium, chart cilium/cilium (quay.io/cilium/charts), namespace kube-system. First release.
# Cilium chained on top of the AWS VPC CNI: the VPC CNI keeps giving the pods their VPC IP addresses (so the
# NLB with nlb-target-type ip and Pod Identity are untouched), Cilium enforces the NetworkPolicies and
# Hubble shows the flows. These are the settings of the AWS VPC CNI chaining guide of Cilium.
# Karpenter nodes start with the taint node.cilium.io/agent-not-ready (values/karpenter-nodes.yaml.gotmpl), which
# the Cilium agent removes once ready: no pod starts on a node before Cilium covers it.
cni:
  chainingMode: aws-cni
  # Leave the VPC CNI configuration in place
  exclusive: false
enableIPv4Masquerade: false
routingMode: native
endpointRoutes:
  enabled: true

# Images come from quay.io. useDigest false: the chart pins digests of the upstream images, which a registry
# remote or mirror may not serve. The operator image is rendered as <repository>-generic.
image:
  repository: "{{ $r.quay }}/cilium/cilium"
  useDigest: false
envoy:
  image:
    repository: "{{ $r.quay }}/cilium/cilium-envoy"
    useDigest: false
operator:
  image:
    repository: "{{ $r.quay }}/cilium/operator"
    useDigest: false
  # Runs on the system node group (CriticalAddonsOnly), the only nodes before Karpenter: the agents wait for
  # the operator to register the Cilium CRDs. The list replaces the chart's defaults, kept below.
  tolerations:
    - key: CriticalAddonsOnly
      operator: Exists
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
    - key: node-role.kubernetes.io/master
      operator: Exists
    - key: node.kubernetes.io/not-ready
      operator: Exists
    - key: node.cloudprovider.kubernetes.io/uninitialized
      operator: Exists
    - key: node.cilium.io/agent-not-ready
      operator: Exists
certgen:
  image:
    repository: "{{ $r.quay }}/cilium/certgen"
    useDigest: false
# Hubble: flow observability, read through the relay. UI: kubectl port-forward -n kube-system svc/hubble-ui 12000:80
hubble:
  enabled: true
  relay:
    enabled: true
    image:
      repository: "{{ $r.quay }}/cilium/hubble-relay"
      useDigest: false
    nodeSelector:
      armonik.aneo.fr/node-pool: core
  ui:
    enabled: true
    backend:
      image:
        repository: "{{ $r.quay }}/cilium/hubble-ui-backend"
        useDigest: false
    frontend:
      image:
        repository: "{{ $r.quay }}/cilium/hubble-ui"
        useDigest: false
    nodeSelector:
      armonik.aneo.fr/node-pool: core

{{- if .Values.registryAuth }}
# Registry with authentication (registryAuth in settings.yaml): the Secret must exist in kube-system
imagePullSecrets:
  - name: registry-credentials
{{- end }}
