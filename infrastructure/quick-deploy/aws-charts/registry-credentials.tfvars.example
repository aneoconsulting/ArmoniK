# Copy to registry-credentials.tfvars (git-ignored) and fill in. Upstream credentials of the ECR pull-through
# cache, required by AWS for Docker Hub and GitHub. Terraform writes them to Secrets Manager and never to the state.
registry_credentials = {
  docker_hub = {
    username     = "glutenfree69"
    access_token = "..." # read-only access token
  }
  github = {
    username     = "Glutenfree69"
    access_token = "..." # classic token, scope read:packages
  }
}

# To rotate the tokens: change them above and bump this number
# registry_credentials_version = 2
