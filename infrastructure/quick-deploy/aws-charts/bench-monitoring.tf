# Monitoring of the bench, to clean up after it: dashboards of the Grafana folder Bench (charts/bench-monitoring,
# generated by its dashboards/gen.py) over three sources:
#   - CloudWatch datasource: Aurora (serverless capacity, instance, billed I/O), RDS Proxy, SQS, S3 request metrics
#   - postgres_exporter -> Prometheus: engine statistics and the custom queries of the chart, every 15 s
#   - Cilium agents, operator and Hubble -> Prometheus (PodMonitors of the chart): flows, drops, pod IPs and ENIs
#   - PostgreSQL datasource: task-level SQL on the tables of Core, run only when a dashboard is displayed
# postgres_exporter and the PostgreSQL datasource read the writer directly (not the proxy) as a read-only user.

# CloudWatch datasource: Grafana reads the metrics with its own pod credentials. Its service account is created by
# the grafana dependency of the armonik chart; terraform_data.platform makes the release wait for the association.
module "grafana_identity" {
  source = "git::https://github.com/aneoconsulting/ArmoniK.Infra.git//service-account/aws?ref=dw/aws-charts-modules"
  count  = var.bench_monitoring ? 1 : 0

  prefix                 = local.name
  name                   = "armonik-grafana"
  namespace              = var.namespace
  create_service_account = false
  pod_identity           = true
  cluster_name           = terraform_data.system_nodes.output.cluster_name
  oidc_provider_arn      = module.eks.aws_eks_module.oidc_provider_arn
  oidc_issuer_url        = module.eks.issuer
  tags                   = local.tags
}

resource "aws_iam_role_policy_attachment" "grafana_cloudwatch" {
  count      = var.bench_monitoring ? 1 : 0
  role       = module.grafana_identity[0].service_account_iam_role_name
  policy_arn = "arn:${local.partition}:iam::aws:policy/CloudWatchReadOnlyAccess"
}

# S3 request metrics (1 point per minute, billed as custom metrics): requests by type, 4xx/5xx (503 SlowDown while S3
# splits a prefix), latencies, bytes. The storage metrics alone are daily.
resource "aws_s3_bucket_metric" "object_storage" {
  count  = var.bench_monitoring ? 1 : 0
  bucket = module.object_storage.s3_bucket_name
  name   = "EntireBucket"
}

resource "random_password" "postgresql_monitoring" {
  count   = var.bench_monitoring ? 1 : 0
  length  = 32
  special = false
}

# After the armonik release: the PrometheusRule CRD comes with the operators, the Grafana sidecar loads the
# dashboards and datasources, and the hook Job creates the read-only user with the Secret of Core.
resource "helm_release" "bench_monitoring" {
  count = var.bench_monitoring ? 1 : 0

  name      = "bench-monitoring"
  namespace = terraform_data.armonik[0].output.namespace
  chart     = "${path.module}/charts/bench-monitoring"
  values = [yamlencode({
    operatorsNamespace = var.operators_namespace
    region             = var.region
    aurora = {
      cluster  = module.database.cluster_identifier
      instance = "${module.database.cluster_identifier}-0"
      # The aurora module names the proxy after the cluster
      proxy = module.database.pooler_host == null ? "" : module.database.cluster_identifier
    }
    queuePrefix = local.sqs_prefix
    bucket      = module.object_storage.s3_bucket_name
    postgresql = {
      host        = module.database.host
      port        = module.database.port
      database    = module.database.database
      ca          = module.database.ca_cert
      adminSecret = kubernetes_secret_v1.postgresql.metadata[0].name
    }
    psqlImage = "${local.registries.dockerHub}/library/postgres:18-alpine"
  })]
  set_sensitive {
    name  = "postgresql.monitoring.password"
    value = random_password.postgresql_monitoring[0].result
  }
  wait = true
}

resource "helm_release" "postgres_exporter" {
  count = var.bench_monitoring ? 1 : 0

  name       = "postgres-exporter"
  namespace  = helm_release.bench_monitoring[0].namespace
  repository = "https://prometheus-community.github.io/helm-charts"
  chart      = "prometheus-postgres-exporter"
  version    = "8.2.4"

  values = [yamlencode({
    fullnameOverride = "postgres-exporter"
    image = {
      registry   = local.registries.quay
      repository = "prometheuscommunity/postgres-exporter"
    }
    config = {
      datasource = {
        host     = module.database.host
        port     = tostring(module.database.port)
        database = module.database.database
        user     = "armonik_monitoring"
        passwordSecret = {
          name = "postgresql-monitoring"
          key  = "password"
        }
        # The server certificate is verified against the RDS CA, host name included
        sslmode     = "verify-full"
        extraParams = "sslrootcert=/ca/ca.crt&application_name=postgres_exporter"
      }
      extraArgs = [
        "--extend.query-path=/queries/queries.yaml",
        "--collector.stat_statements",
        "--collector.stat_statements.include_query",
        "--collector.stat_statements.query_length=200",
        "--collector.stat_statements.limit=50",
        "--collector.stat_activity",
        "--collector.stat_activity_autovacuum",
        "--collector.stat_checkpointer",
        "--collector.long_running_transactions",
        "--collector.statio_user_indexes",
      ]
    }
    # Secrets and ConfigMap of the bench-monitoring chart
    extraVolumes = [
      { name = "ca", secret = { secretName = "postgresql-monitoring-ca" } },
      { name = "queries", configMap = { name = "postgres-exporter-queries" } },
    ]
    extraVolumeMounts = [
      { name = "ca", mountPath = "/ca", readOnly = true },
      { name = "queries", mountPath = "/queries", readOnly = true },
    ]
    serviceMonitor = {
      enabled  = true
      interval = "15s"
    }
    resources = {
      requests = { cpu = "50m", memory = "64Mi" }
      limits   = { memory = "256Mi" }
    }
  })]
}
