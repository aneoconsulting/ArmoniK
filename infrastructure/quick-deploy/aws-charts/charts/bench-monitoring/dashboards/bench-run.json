{
  "uid": "armonik-bench-run",
  "title": "Bench - run",
  "description": "During a campaign: throughput against the target, the queue, the agents, then the platform (Aurora, RDS Proxy, SQS, S3, control plane). Details in the other Bench dashboards.",
  "tags": [
    "armonik",
    "bench"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "partition",
        "label": "Partition",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(kube_deployment_spec_replicas{namespace=\"__NAMESPACE__\",deployment=~\"armonik-compute-plane-.+\"}, deployment)",
          "refId": "partition"
        },
        "regex": "/armonik-compute-plane-(.+)/",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "htcmock",
          "value": "htcmock"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Bench steps",
        "enable": true,
        "iconColor": "rgba(0, 150, 255, 0.6)",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "target": {
          "type": "tags",
          "tags": [
            "bench"
          ],
          "matchAny": true,
          "limit": 200
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Completed/s",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(armonik:tasks_ended:rate1m)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Ends of tasks, all partitions (only the campaign's runs)"
    },
    {
      "type": "stat",
      "title": "Submitted/s",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(GrpcTasksService_SubmitTasks_Count_total{namespace=\"__NAMESPACE__\"}[1m])) * 100",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "SubmitTasks calls x 100, the batch of the Bench client"
    },
    {
      "type": "stat",
      "title": "Queue",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum({__name__=\"armonik_${partition}_tasks_queued\"}) + sum({__name__=\"armonik_${partition}_tasks_dispatched\"})",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Submitted and dispatched tasks of the partition"
    },
    {
      "type": "stat",
      "title": "Busy ratio",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum({__name__=\"armonik_${partition}_tasks_processing\"}) / sum(kube_deployment_status_replicas_available{namespace=\"__NAMESPACE__\",deployment=\"armonik-compute-plane-$partition\"})",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Ready pods",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"__NAMESPACE__\",deployment=\"armonik-compute-plane-$partition\"})",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Database CPU",
      "id": 7,
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{AWS/RDS,DBInstanceIdentifier} MetricName=\"CPUUtilization\" DBInstanceIdentifier=\"__AURORA_INSTANCE__\"', 'Average', 60)",
          "id": "",
          "region": "default",
          "label": "CPU",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Database ACU",
      "id": 8,
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{AWS/RDS,DBInstanceIdentifier} MetricName=\"ServerlessDatabaseCapacity\" DBInstanceIdentifier=\"__AURORA_INSTANCE__\"', 'Average', 60)",
          "id": "",
          "region": "default",
          "label": "ACU",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Serverless v2: 1 ACU is about 2 GiB of memory with the matching CPU, by steps of 0.5. Empty with provisioned instances"
    },
    {
      "type": "stat",
      "title": "Workers nodes (spot)",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(kube_node_labels{label_karpenter_sh_nodepool=\"workers\",label_karpenter_sh_capacity_type=\"spot\"}) or vector(0)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "A drop during a step: spot interruptions, the step is not valid"
    },
    {
      "type": "row",
      "title": "Throughput",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Submitted and completed",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(armonik:tasks_ended:rate1m)",
          "legendFormat": "completed/s",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        },
        {
          "expr": "sum(rate(GrpcTasksService_SubmitTasks_Count_total{namespace=\"__NAMESPACE__\"}[1m])) * 100",
          "legendFormat": "submitted/s",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "A step holds when the completions reach 95 % of its target (workers / task duration)"
    },
    {
      "type": "timeseries",
      "title": "Completed per pod and busy ratio",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(armonik:tasks_ended:rate1m) / sum(kube_deployment_status_replicas_available{namespace=\"__NAMESPACE__\",deployment=\"armonik-compute-plane-$partition\"})",
          "legendFormat": "tasks/s per pod",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        },
        {
          "expr": "sum({__name__=\"armonik_${partition}_tasks_processing\"}) / sum(kube_deployment_status_replicas_available{namespace=\"__NAMESPACE__\",deployment=\"armonik-compute-plane-$partition\"})",
          "legendFormat": "busy ratio",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "busy ratio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Queue",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tasks of the partition",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum({__name__=\"armonik_${partition}_tasks_queued\"})",
          "legendFormat": "queued",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        },
        {
          "expr": "sum({__name__=\"armonik_${partition}_tasks_dispatched\"})",
          "legendFormat": "dispatched",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "B"
        },
        {
          "expr": "sum({__name__=\"armonik_${partition}_tasks_processing\"})",
          "legendFormat": "processing",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Queued growing through a step: the platform does not keep up"
    },
    {
      "type": "timeseries",
      "title": "SQS: visible and in flight",
      "id": 15,
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SUM(SEARCH('{AWS/SQS,QueueName} MetricName=\"ApproximateNumberOfMessagesVisible\" QueueName=__QUEUE_PREFIX__', 'Maximum', 60))",
          "id": "",
          "region": "default",
          "label": "visible",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A"
        },
        {
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SUM(SEARCH('{AWS/SQS,QueueName} MetricName=\"ApproximateNumberOfMessagesNotVisible\" QueueName=__QUEUE_PREFIX__', 'Maximum', 60))",
          "id": "",
          "region": "default",
          "label": "in flight",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "CloudWatch: a few minutes late"
    },
    {
      "type": "timeseries",
      "title": "SQS: oldest message",
      "id": 16,
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{AWS/SQS,QueueName} MetricName=\"ApproximateAgeOfOldestMessage\" QueueName=__QUEUE_PREFIX__', 'Maximum', 60)",
          "id": "",
          "region": "default",
          "label": "${PROP('Dim.QueueName')}",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
