    {
      "type": "timeseries",
      "title": "Agent CPU (m)",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "quantile(0.5, armonik:container_cpu_millicores:rate1m{partition=\"$partition\",container=\"agent\"})",
          "legendFormat": "median",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        },
        {
          "expr": "quantile(0.95, armonik:container_cpu_millicores:rate1m{partition=\"$partition\",container=\"agent\"})",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "B"
        },
        {
          "expr": "1000 * avg(kube_pod_container_resource_requests{namespace=\"__NAMESPACE__\",pod=~\"armonik-compute-plane-$partition-[a-z0-9]+-[a-z0-9]+\",container=\"agent\",resource=\"cpu\"})",
          "legendFormat": "request",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "p95 above the request: the nodes are packed beyond what the pairs use"
    },
    {
      "type": "timeseries",
      "title": "Agent memory (MiB)",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(armonik:container_memory_working_set_mib{partition=\"$partition\",container=\"agent\"})",
          "legendFormat": "max",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        },
        {
          "expr": "avg(kube_pod_container_resource_limits{namespace=\"__NAMESPACE__\",pod=~\"armonik-compute-plane-$partition-[a-z0-9]+-[a-z0-9]+\",container=\"agent\",resource=\"memory\"}) / 1048576",
          "legendFormat": "limit",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
