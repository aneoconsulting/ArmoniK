          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "refId": "A"
        },
        {
          "expr": "avg(kube_pod_init_container_resource_limits{namespace=\"__NAMESPACE__\",pod=~\"armonik-compute-plane-$partition-[a-z0-9]+-[a-z0-9]+\",container=\"worker\",resource=\"memory\"}) / 1048576",
          "legendFormat": "limit",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
