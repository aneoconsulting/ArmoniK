# Copy to terraform.tfvars (git-ignored). All the parameters: variables.tf.

project = "my-project"

# region = "europe-west9"
# zone   = "europe-west9-a"

# Name of the cluster and prefix of every resource: change it to deploy twice in the same project
# prefix = "armonik"

# Read-only tokens against the anonymous rate limits of the upstream registries
# registry_credentials = {
#   dockerhub = { username = "me", token = "dckr_pat_..." }
#   ghcr      = { username = "me", token = "ghp_..." }   # scope read:packages
# }

# Who may reach the load balancer (ArmoniK API, GUI, Seq, Grafana: no authentication)
# ingress_allowed_cidrs = ["203.0.113.4/32"]

# node_classes = {
#   workers = {
#     machine_families = ["n2d", "c3d"]
#     min_cores        = 16
#   }
# }

# Your workers, on top of the chart's default, stream and htcmock partitions. A worker update is a new tag here and
# an apply.
# partitions = {
#   myapp = {
#     image  = "europe-west9-docker.pkg.dev/my-project/my-repo/my-worker"
#     tag    = "1.0.0"
#     cpu    = "2"
#     memory = "4Gi"
#   }
# }

# Autoscaling of a partition (autoscaling/README.md): the law KEDA reads and how the HPA applies it. Without the block:
# the chart's queue length trigger and HPA.
# partitions = {
#   myapp = {
#     image = "europe-west9-docker.pkg.dev/my-project/my-repo/my-worker"
#     tag   = "1.0.0"
#     autoscaling = {
#       law             = "model" # queue, dual or model
#       hpa             = "fast"  # chart, fast or ramp
#       catchup_seconds = 120     # time given to absorb the queue (60)
#       startup_seconds = 90      # pod startup, node included: the model then predicts the queue at that horizon
#     }
#   }
# }

# Twin partitions of the autoscaling bench (bench/autoscaling.py): the same worker under each law, q = queue,
# d = dual, m = model, all with the fast HPA. One workload per trio, so that each keeps its own task duration:
# short200 and short1s (Bench tasks of 200 ms and 1 s), long (5 min), htcmock (subtasks).
# partitions = {
#   short200q = { image = "docker.io/dockerhubaneo/armonik_core_bench_test_worker", tag = "0.41.4", max_replicas = 100, autoscaling = { law = "queue", hpa = "fast" } }
#   short200d = { image = "docker.io/dockerhubaneo/armonik_core_bench_test_worker", tag = "0.41.4", max_replicas = 100, autoscaling = { law = "dual", hpa = "fast" } }
#   short200m = { image = "docker.io/dockerhubaneo/armonik_core_bench_test_worker", tag = "0.41.4", max_replicas = 100, autoscaling = { law = "model", hpa = "fast" } }
#   short1sq  = { image = "docker.io/dockerhubaneo/armonik_core_bench_test_worker", tag = "0.41.4", max_replicas = 100, autoscaling = { law = "queue", hpa = "fast" } }
#   short1sd  = { image = "docker.io/dockerhubaneo/armonik_core_bench_test_worker", tag = "0.41.4", max_replicas = 100, autoscaling = { law = "dual", hpa = "fast" } }
#   short1sm  = { image = "docker.io/dockerhubaneo/armonik_core_bench_test_worker", tag = "0.41.4", max_replicas = 100, autoscaling = { law = "model", hpa = "fast" } }
#   longq     = { image = "docker.io/dockerhubaneo/armonik_core_bench_test_worker", tag = "0.41.4", max_replicas = 100, autoscaling = { law = "queue", hpa = "fast" } }
#   longd     = { image = "docker.io/dockerhubaneo/armonik_core_bench_test_worker", tag = "0.41.4", max_replicas = 100, autoscaling = { law = "dual", hpa = "fast" } }
