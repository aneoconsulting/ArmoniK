# Copy to terraform.tfvars (git-ignored). All the parameters: variables.tf.

project = "my-project"

# region = "europe-west9"
# zone   = "europe-west9-a"

# Name of the cluster and prefix of every resource: change it to deploy twice in the same project
# prefix = "armonik"

# Read-only tokens against the anonymous rate limits of the upstream registries
# registry_credentials = {
#   dockerhub = { username = "me", token = "dckr_pat_..." }
#   ghcr      = { username = "me", token = "ghp_..." }   # scope read:packages
# }

# Who may reach the load balancer (ArmoniK API, GUI, Seq, Grafana: no authentication)
# ingress_allowed_cidrs = ["203.0.113.4/32"]

# node_classes = {
#   workers = {
#     machine_families = ["n2d", "c3d"]
#     min_cores        = 16
#   }
# }

# Your workers, on top of the chart's default, stream and htcmock partitions. A worker update is a new tag here and
# an apply.
# partitions = {
#   myapp = {
#     image  = "europe-west9-docker.pkg.dev/my-project/my-repo/my-worker"
#     tag    = "1.0.0"
#     cpu    = "2"
#     memory = "4Gi"
#   }
# }
