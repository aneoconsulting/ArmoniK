{
  "uid": "armonik-bench-queue-objects",
  "title": "Bench - Pub/Sub and GCS",
  "description": "Pub/Sub topics and subscriptions of the partitions, GCS bucket of the payloads and results (Cloud Monitoring: points every minute, a few minutes late).",
  "tags": [
    "armonik",
    "bench"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Pub/Sub: flow",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Published messages/s by topic",
      "id": 3,
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "pubsub.googleapis.com/topic/send_message_operation_count",
              "AND",
              "resource.labels.topic_id",
              "=~",
              "__PUBSUB_PREFIX__-.*"
            ],
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupBys": [
              "resource.label.topic_id"
            ],
            "alignmentPeriod": "cloud-monitoring-auto",
            "view": "FULL"
          },
          "aliasBy": "{{resource.label.topic_id}}",
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-monitoring"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Tasks submitted to the queue (one message per task)"
    },
