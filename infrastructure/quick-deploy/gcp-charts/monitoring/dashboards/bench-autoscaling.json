      "targets": [
        {
          "expr": "sum_over_time(max(armonik:tasks_waiting{partition=\"$partition\"})[$__range:5s]) * 5 / sum(increase(TaskHandler_ExecuteTask_milliseconds_count{job=\"metrics-polling-agent\",armonik_fr_partition=\"$partition\"}[$__range]))",
