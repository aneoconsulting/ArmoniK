{
  "uid": "armonik-bench-autoscaling",
  "title": "Bench - autoscaling",
  "description": "The three autoscaling laws of autoscaling/rules.yaml on the same load, the pods the HPA made of the one the partition selects, and the cost: idle pods and queue wait. The laws a partition does not select are computed on what happened under the selected one: what they would have asked, not what would have happened.",
  "tags": [
    "armonik",
    "bench"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "partition",
        "label": "Partition",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(kube_deployment_spec_replicas{namespace=\"armonik\",deployment=~\"armonik-compute-plane-.+\"}, deployment)",
          "refId": "partition"
        },
        "regex": "/armonik-compute-plane-(.+)/",
        "refresh": 2,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Over the displayed time range: set it on one run to compare two runs",
      "id": 2,
