    {
      "type": "timeseries",
      "title": "CPU utilization",
      "id": 3,
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "cloudsql.googleapis.com/database/cpu/utilization",
              "AND",
              "resource.labels.database_id",
              "=",
              "__CLOUDSQL_DATABASE_ID__"
            ],
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_NONE",
            "groupBys": [],
            "alignmentPeriod": "cloud-monitoring-auto",
            "view": "FULL"
          },
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-monitoring"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
